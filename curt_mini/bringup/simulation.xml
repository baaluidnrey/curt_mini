<?xml version="1.0" encoding="UTF-8"?>
<launch>

      <!-- Gazebo -->
      <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
            <arg name="gz_args" value="-r -v 1 empty.sdf"/>
      </include>

      <timer period="2.0">
      <node
            pkg="ros_gz_sim"
            exec="create"
            output="screen"
            args="-topic robot_description -name curt_mini">
            <param name="use_sim_time" value="true"/>
      </node>
      </timer>

      <!-- Robot State Publisher -->
      <node pkg="robot_state_publisher"
            exec="robot_state_publisher"
            output="screen">
            <param name="robot_description"
                  value="$(command 'xacro $(find-pkg-share curt_mini)/models/curt_mini/robot.urdf.xacro simulation:=True')"/>
            <param name="use_sim_time" value="true"/>
      </node>

      <!-- Controller manager -->
      <node pkg="controller_manager"
            exec="spawner"
            output="screen"
            args="--param-file $(find-pkg-share curt_mini)/config/ros2_control.yaml">
            <param name="use_sim_time" value="true"/>
      </node>

      <node pkg="controller_manager"
            exec="spawner"
            output="screen"
            args="--param-file $(find-pkg-share curt_mini)/config/ros2_control.yaml joint_state_broadcaster">
            <param name="use_sim_time" value="true"/>
      </node>

      <!-- RViz -->
      <node pkg="rviz2"
            exec="rviz2"
            name="rviz2"
            output="screen"
            args="-d $(find-pkg-share curt_mini)/bringup/curt_mini.rviz">
            <param name="use_sim_time" value="true"/>
      </node>

</launch>